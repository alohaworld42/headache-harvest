# Copy to .env.local for local development, or set these in the Vercel project settings.
# Without them the app runs fine — only the paid checkout stays disabled.

# --- Stripe (server side, never exposed to the browser) -----------------------
STRIPE_SECRET_KEY=
# At least one price id is required for checkout to appear.
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_YEARLY=
# Random string used to sign licence tokens. Do not change once keys were issued.
LICENSE_SECRET=
# Optional: base URL Stripe returns to. Defaults to the request host.
APP_URL=
# Optional: set to 1 to enable Stripe Tax.
STRIPE_AUTOMATIC_TAX=

# --- Legal pages (build time, bundled into the client) ------------------------
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_VAT_ID=
